#!/usr/bin/env bash
# Pick a window from any session with fzf and switch to it. The preview
# shows the window's active pane.
#
# tmux.conf calls this in a popup:
#   window-switcher
set -u

# Each line is "<window id><tab><session>:<index> <name>". fzf shows only
# the part after the tab. The _claude session holds hidden Claude panes.
win=$(
  tmux list-windows -a -F "#{window_id}	#S:#I #W#{?window_active, *,}" \
    -f '#{!=:#{session_name},_claude}' |
    fzf --reverse --prompt 'window> ' --delimiter '\t' --with-nth 2 \
      --preview 'tmux capture-pane -ep -t {1}' --preview-window 'right,60%' |
    cut -f1
)
[ -n "$win" ] || exit 0
tmux switch-client -t "$win"
