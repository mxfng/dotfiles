#!/usr/bin/env fish

cd (dirname (status filename))

source ./.config/fish/functions/log.fish
source ./.config/fish/functions/confirm.fish

set -l distro (awk -F= '/^ID=/ {print $2}' /etc/os-release)

test (uname) != Linux
and echo 'error: this script is for Linux only'
and exit 1

log "provisioning Linux environment for $USER ($distro)"

log "installing packages"
switch $distro
    case arch cachyos
        paru -S --needed --noconfirm \
            asdf-vm \
            bat \
            brightnessctl \
            btop \
            curl \
            docker \
            docker-buildx \
            docker-compose \
            dunst \
            fd \
            ffmpeg \
            fish \
            fzf \
            git \
            git-delta \
            git-lfs \
            github-cli \
            glow \
            grpcurl \
            gum \
            helium-browser-bin \
            hyprland \
            hypridle \
            hyprlock \
            hyprpaper \
            jq \
            k9s \
            keyd \
            kubectl \
            lazydocker \
            lazygit \
            mkcert \
            neovim \
            obs-studio \
            ouch \
            pgcli \
            playerctl \
            polkit-kde-agent \
            rancher-k3d-bin \
            ripgrep \
            rofi \
            rsync \
            starship \
            tailscale \
            tmux \
            tree-sitter-cli \
            ttf-jetbrains-mono-nerd \
            uv \
            waybar \
            wireplumber \
            wezterm-nightly-bin \
            wl-clipboard \
            zen-browser-bin \
            zoxide
    case ubuntu debian
        sudo apt-get update
        and sudo apt-get install -y \
            bat \
            btop \
            curl \
            fd-find \
            ffmpeg \
            fish \
            fzf \
            git \
            git-lfs \
            gum \
            jq \
            mkcert \
            neovim \
            pgcli \
            ripgrep \
            rsync \
            tmux \
            zoxide
    case '*'
        echo "error: unsupported distro '$distro'"
        exit 1
end
or exit 1

./sync
or exit 1

log "setting up shell"
fish_add_path $HOME/.local/bin

if test $SHELL != (which fish)
    chsh -s (which fish)
    or exit 1
end

./scripts/fish_generate_completions.fish
or echo 'warning: failed to generate fish completions'

log "setting up terminal tools"
./scripts/tmux_setup_plugins.fish
or echo 'warning: failed to set up tmux plugins'

./scripts/git_setup_lfs.fish
or echo 'warning: failed to set up git-lfs'

log "setting up docker"
sudo systemctl enable --now docker.service
or echo 'warning: failed to enable docker'

if not groups $USER | grep -q docker
    sudo usermod -aG docker $USER
    echo 'added user to docker group (logout required to take effect)'
end

if command -q tailscale
    sudo systemctl enable --now tailscaled.service
    or echo 'warning: failed to enable tailscale'
end

./scripts/keyd_configure.fish
or echo 'warning: failed to set up keyd'

# Acer laptops: stop charging at about 80% (Acer's battery health mode), so one left on its charger
# around the clock, as a server, doesn't wear its battery out. Acer keeps the setting out of the
# firmware setup, so it comes from the acer-wmi-battery driver.
if contains $distro arch cachyos; and string match -qi '*acer*' (cat /sys/class/dmi/id/sys_vendor 2>/dev/null)
    log "turning on Acer battery health mode"
    paru -S --needed --noconfirm acer-wmi-battery-dkms
    and echo "options acer-wmi-battery enable_health_mode=1" | sudo tee /etc/modprobe.d/acer-wmi-battery.conf >/dev/null
    and echo acer-wmi-battery | sudo tee /etc/modules-load.d/acer-wmi-battery.conf >/dev/null
    and sudo modprobe acer-wmi-battery
    and echo 1 | sudo tee /sys/bus/wmi/drivers/acer-wmi-battery/health_mode >/dev/null
    or echo 'warning: failed to turn on Acer battery health mode'
end

echo 'done provisioning Linux'
