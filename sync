#!/usr/bin/env fish

cd (dirname (status filename))

source ./.config/fish/functions/log.fish

log 'syncing dotfiles'

# Ensure directories exist
mkdir -p ~/.config ~/Developer/scripts

# Ensure XDG state dirs exist for tools that don't create them automatically
mkdir -p ~/.local/state/{less,psql,node}

# Capture git user info before syncing (will restore after)
set -l git_name (git config --global user.name 2>/dev/null)
set -l git_email (git config --global user.email 2>/dev/null)

rsync -aP --delete \
    --exclude fish/completions/ \
    --exclude fish/fish_variables \
    --exclude tmux/plugins/ \
    ./.config/fish \
    ./.config/git \
    ./.config/nvim \
    ./.config/ssh \
    ./.config/starship.toml \
    ./.config/tmux \
    ./.config/wezterm \
    ~/.config/
or exit 1

# ssh only reads ~/.ssh/config, so include the shared hosts from there.
# Prepended because Include only applies globally before the first Host block.
set -l ssh_include 'Include ~/.config/ssh/config'
mkdir -p ~/.ssh; and chmod 700 ~/.ssh
if not contains -- $ssh_include (cat ~/.ssh/config 2>/dev/null)
    begin
        echo $ssh_include
        echo
        cat ~/.ssh/config 2>/dev/null
    end >~/.ssh/config.tmp
    and chmod 600 ~/.ssh/config.tmp
    and mv ~/.ssh/config.tmp ~/.ssh/config
    or echo 'warning: failed to add shared include to ~/.ssh/config'
end

# TODO: Remove this when Trunk.io ships newer npm version, blocks stray cache entires on old version
rsync -aP ./.config/npmrc ~/.npmrc

# Agentic: AGENTS.md at ~ for tool discovery, guides under ~/.config/agents
rsync -aP ./.config/agents/AGENTS.md ~/AGENTS.md
rsync -aP ./.config/agents/{VOICE,OPINIONS}.md ~/.config/agents/
mkdir -p ~/.claude; and ln -sf ../AGENTS.md ~/.claude/CLAUDE.md
rsync -aP ./.config/agents/claude/settings.json ~/.claude/settings.json

# Personal Claude Code skills. No --delete: protect externally installed skills
if test -d ./.config/agents/skills
    mkdir -p ~/.claude/skills
    rsync -aP ./.config/agents/skills/ ~/.claude/skills/
end

# Platform-specific
if test (uname) = Darwin
    # macOS
    rsync -aP --delete ./.config/aerospace ~/.config/

    # Surgical sync because these store their runtime state
    if test -d ./.config/sol
        mkdir -p ~/.config/sol
        rsync -aP ./.config/sol/config.json ~/.config/sol/
        rsync -aP --delete ./.config/sol/scripts/ ~/.config/sol/scripts/
    end
    if test -d ./.config/colima
        mkdir -p ~/.config/colima/default
        rsync -aP ./.config/colima/default/colima.yaml ~/.config/colima/default/
    end
else
    # Linux
    rsync -aP --delete \
        ./.config/hypr \
        ./.config/rofi \
        ./.config/waybar \
        ~/.config/

    # Desktop entries (lock screen, power off, restart)
    mkdir -p ~/.local/share/applications
    rsync -aP ./.local/share/applications/ ~/.local/share/applications/
end

# Audit ~/.config/ and flag any lingering configs not in allowlist
./scripts/config_audit.fish --quiet

# Sync scripts
rsync -aP --delete ./scripts/ ~/Developer/scripts/
or exit 1

log 'syncing git config'

if test -z "$git_name" -o -z "$git_email"
    echo 'please set your git user:'

    if test -z "$git_name"
        read -P 'name: ' name
        git config --global user.name $name
    else
        echo "name: $git_name (already set)"
    end

    if test -z "$git_email"
        read -P 'email: ' email
        git config --global user.email $email
    else
        echo "email: $git_email (already set)"
    end
else
    echo "git user: $git_name <$git_email>"
    git config --global user.name $git_name
    git config --global user.email $git_email
end

echo 'done syncing'
